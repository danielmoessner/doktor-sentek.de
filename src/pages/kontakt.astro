---
import BaseLayout from '../layouts/BaseLayout.astro';
import sanitizeHtml from 'sanitize-html';
import { getPageContentBySlug, getSettingContentBySlug } from '../lib/content';
import { cmsAssetToPublicUrl } from '../lib/cms-paths';

const [page, contact, appointments, indication] = await Promise.all([
  getPageContentBySlug('contact'),
  getSettingContentBySlug('contact'),
  getSettingContentBySlug('appointments'),
  getSettingContentBySlug('indication'),
]);

const sideImage = cmsAssetToPublicUrl(page?.header?.image);
const withBreaks = (value = '') => sanitizeHtml(String(value).replace(/\n/g, '<br />'));
---

<BaseLayout title={page?.meta?.title} description={page?.meta?.description}>
  <header class="bg-teal-800 shadow">
    {page?.header?.title && page?.header?.text && (
      <div class="relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-6">
          <div class="flex flex-col-reverse md:flex-row md:justify-between md:items-center">
            <div class="max-w-xl py-8 md:pt-8 md:pb-10">
              <h1 class="text-4xl font-medium text-teal-050 md:text-5xl sm:tracking-tight">{page.header.title}</h1>
              <p class="mt-2 text-xl text-teal-050 lg:mt-5">{page.header.text}</p>
            </div>
            {sideImage && (
              <div class="w-full md:w-1/2 pt-5 md:pt-0">
                <div class="aspect-h-8 aspect-w-16">
                  <img class="w-auto max-w-full h-full object-contain" src={sideImage} alt={page.header.title} loading="eager" />
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    )}
  </header>

  <section>
    <div class="bg-white">
      <div class="px-4 py-16 mx-auto max-w-7xl sm:px-6 lg:px-8">
        <div class="max-w-lg mx-auto md:max-w-none md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h2 class="text-2xl font-extrabold text-gray-900 sm:text-3xl">{page?.contact?.title1}</h2>
            <div class="mt-3">
              <p class="text-lg text-gray-500" set:html={withBreaks(page?.contact?.text1 || '')} />
            </div>

            <div class="mt-9">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="w-6 h-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <a href={`tel:${contact?.phone || ''}`} class="ml-3 text-base font-medium text-gray-600 hover:text-teal-800">{contact?.phone}</a>
              </div>

              <div class="flex mt-6">
                <div class="flex-shrink-0">
                  <svg class="w-6 h-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <a href={`mailto:${contact?.email || ''}`} class="ml-3 text-base font-medium text-gray-600 hover:text-teal-800">{contact?.email}</a>
              </div>

              <div class="flex mt-6">
                <div class="flex-shrink-0">
                  <svg class="w-6 h-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="ml-3 text-base text-gray-500">
                  <address class="not-italic" set:html={withBreaks(contact?.address || '')} />
                </div>
              </div>

              <div class="flex mt-6">
                <div class="flex-shrink-0">
                  <svg class="w-6 h-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="ml-3 text-base text-gray-500">{contact?.fax}</div>
              </div>
            </div>

            <div class="mt-9">
              <h2 class="text-2xl font-extrabold text-gray-900 sm:text-3xl">{page?.contact?.title2}</h2>
              <iframe
                class="w-full mt-3"
                title="Maps"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2337.4125763402276!2d12.056870416396459!3d54.137337122867955!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47ac56621be6c67b%3A0xfbc52ed0b5426d9c!2sTrelleborger%20Str.%2010B%2C%2018107%20Rostock!5e0!3m2!1sde!2sde!4v1626190176670!5m2!1sde!2sde"
                width="600"
                height="450"
                style="border:0;"
                allowfullscreen
                loading="lazy"
              />
            </div>
          </div>

          <div class="mt-12 sm:mt-16 md:mt-0">
            <h2 class="text-2xl font-extrabold text-gray-900 sm:text-3xl">{page?.contact?.title3}</h2>
            <div class="mt-3">
              <dl class="sm:divide-y sm:divide-gray-200">
                {(appointments?.appointments || []).map((appointment: any) => (
                  <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                    <dt class="md:text-sm font-medium text-gray-500">{appointment.day}</dt>
                    <dd class="mt-1 md:text-sm text-gray-900 sm:mt-0 sm:col-span-2 sm:text-right">{appointment.openingHours}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <aside>
    <div class="fixed right-0 z-50 top-[25vh] lg:top-[15vh]">
      <button id="indication-toggle" type="button" class="bg-gray-900 text-gray-050 p-3 w-12 rounded-l-full cursor-pointer hover:bg-gray-800 focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>
      <div id="indication-panel" class="absolute right-0 w-80 transform translate-x-full transition-transform duration-150">
        <div class="bg-gray-050 text-gray-900 rounded-l-lg shadow-lg">
          <div class="p-4">
            <h2 class="text-lg font-medium">{indication?.title}</h2>
            <p class="mt-2 whitespace-pre-line">{indication?.text}</p>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <script>
    const toggle = document.getElementById('indication-toggle');
    const panel = document.getElementById('indication-panel');
    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        panel.classList.toggle('translate-x-full');
      });
    }
  </script>
</BaseLayout>
