---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTherapyEntries } from '../../lib/collections';

export async function getStaticPaths() {
  const entries = await getTherapyEntries();
  return entries.map((entry) => ({ params: { slug: entry.routeSlug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<BaseLayout title={entry?.meta?.title || entry?.title} description={entry?.meta?.description || entry?.excerpt}>
  <header class="bg-teal-800 shadow">
    {entry?.title && entry?.excerpt && (
      <div class="relative overflow-hidden">
        <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-6">
          <div class="flex flex-col-reverse md:flex-row md:justify-between md:items-center">
            <div class="max-w-xl py-8 md:pt-8 md:pb-10">
              <h1 class="text-4xl font-medium text-teal-050 md:text-5xl sm:tracking-tight">{entry.title}</h1>
              <p class="mt-2 text-xl text-teal-050 lg:mt-5">{entry.excerpt}</p>
            </div>
            {entry?.image && (
              <div class="w-full pt-5 md:w-1/2 md:pt-0">
                <div class="mx-auto aspect-h-8 aspect-w-16">
                  <img class="object-contain w-auto h-full max-w-full" src={entry.image} alt={entry.title} loading="eager" />
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    )}
  </header>

  <section>
    <div class="relative py-16 overflow-hidden bg-white">
      <div class="hidden lg:block lg:absolute lg:inset-y-0 lg:h-full lg:w-full">
        <div class="h-full mx-auto text-lg max-w-prose" aria-hidden="true">
          <svg class="absolute right-0 transform translate-x-64 top-12 xl:translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="74b3fd99-0a6f-4271-bef2-e80eeafdf357" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#74b3fd99-0a6f-4271-bef2-e80eeafdf357)" />
          </svg>
          <svg class="absolute left-0 transform -translate-x-64 -translate-y-1/2 top-1/2 xl:-translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="f210dbf6-a58d-4871-961e-36d5016a0f49" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#f210dbf6-a58d-4871-961e-36d5016a0f49)" />
          </svg>
          <svg class="absolute right-0 transform translate-x-64 bottom-12 xl:translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="d3eb07ae-5182-43e6-857d-35c643af9034" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#d3eb07ae-5182-43e6-857d-35c643af9034)" />
          </svg>
        </div>
      </div>
      <div class="relative px-4 sm:px-6 lg:px-8">
        <div class="mx-auto prose text-gray-500 prose-teal lg:prose-lg" set:html={entry?.html || ''} />
      </div>
    </div>
  </section>
</BaseLayout>
