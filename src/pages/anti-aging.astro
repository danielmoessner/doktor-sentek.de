---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageContentBySlug, getSettingContentBySlug } from '../lib/content';

const [page, contact] = await Promise.all([
  getPageContentBySlug('antiAging'),
  getSettingContentBySlug('contact'),
]);
---

<BaseLayout title={page?.meta?.title} description={page?.meta?.description}>
  <section>
    <div class="relative py-16 overflow-hidden bg-white">
      <div class="hidden lg:block lg:absolute lg:inset-y-0 lg:h-full lg:w-full">
        <div class="h-full mx-auto text-lg max-w-prose" aria-hidden="true">
          <svg class="absolute right-0 transform translate-x-64 top-12 xl:translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="74b3fd99-0a6f-4271-bef2-e80eeafdf357" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#74b3fd99-0a6f-4271-bef2-e80eeafdf357)" />
          </svg>
          <svg class="absolute left-0 transform -translate-x-64 -translate-y-1/2 top-1/2 xl:-translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="f210dbf6-a58d-4871-961e-36d5016a0f49" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#f210dbf6-a58d-4871-961e-36d5016a0f49)" />
          </svg>
          <svg class="absolute right-0 transform translate-x-64 bottom-12 xl:translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="d3eb07ae-5182-43e6-857d-35c643af9034" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#d3eb07ae-5182-43e6-857d-35c643af9034)" />
          </svg>
        </div>
      </div>

      <div class="relative px-4 sm:px-6 lg:px-8">
        {page?.header && (
          <header class="mx-auto mb-6 text-lg max-w-prose">
            <h1>
              <span class="block text-base font-semibold tracking-wide text-center text-teal-800 uppercase">{page.header.pretitle}</span>
              <span class="block mt-2 text-3xl font-extrabold leading-8 tracking-tight text-center text-gray-900 sm:text-4xl">{page.header.title}</span>
            </h1>
            <p class="mt-8 text-xl leading-8 text-gray-500">{page.header.text}</p>
          </header>
        )}
        <div class="mx-auto prose text-gray-500 prose-teal lg:prose-lg" set:html={page?.bodyHtml || ''} />
      </div>
    </div>
  </section>

  <section class="relative px-4 py-16 overflow-hidden sm:px-6 lg:px-8 lg:py-24" id="formular-danke">
    <div class="max-w-xl mx-auto" id="formular">
      <svg
        class="absolute bottom-0 left-0 transform -translate-x-64 xl:-translate-x-1/4"
        width="404"
        height="384"
        fill="none"
        viewBox="0 0 404 384"
      >
        <defs>
          <pattern id="anti-aging-form-bg-pattern" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
            <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
          </pattern>
        </defs>
        <rect width="404" height="384" fill="url(#anti-aging-form-bg-pattern)" />
      </svg>

      <div class="mt-12">
        <h2
          class="text-3xl font-extrabold tracking-tight text-center text-gray-900 sm:text-4xl"
        >
          {page?.form?.title}
        </h2>

        <p
          class="mt-4 text-lg leading-6 text-center text-gray-500"
        >
          {page?.form?.text}
        </p>

        <div class="flex justify-center mt-12">
          <div class="space-y-6">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="w-6 h-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <a href={`tel:${contact?.phone || ''}`} class="ml-3 text-base font-medium text-gray-600 hover:text-teal-800">{contact?.phone}</a>
            </div>

            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="w-6 h-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <a href={`mailto:${contact?.email || ''}`} class="ml-3 text-base font-medium text-gray-600 hover:text-teal-800">{contact?.email}</a>
            </div>

            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="w-6 h-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <address class="ml-3 text-base not-italic text-gray-500 whitespace-pre-line">{contact?.address}</address>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
