---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getOperationEntries } from '../../lib/collections';
import { getPageContentBySlug } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getOperationEntries();
  return entries.map((entry) => ({ params: { slug: entry.routeSlug }, props: { entry } }));
}

const { entry } = Astro.props;
const page = await getPageContentBySlug('operation');
---

<BaseLayout title={entry?.meta?.title || entry?.title} description={entry?.meta?.description || entry?.excerpt}>
  <header class="bg-teal-800 shadow">
    {entry?.title && entry?.excerpt && (
      <div class="relative overflow-hidden">
        <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-6">
          <div class="flex flex-col-reverse md:flex-row md:justify-between md:items-center">
            <div class="max-w-xl py-8 md:pt-8 md:pb-10">
              <h1 class="text-4xl font-medium text-teal-050 md:text-5xl sm:tracking-tight">{entry.title}</h1>
              <p class="mt-2 text-xl text-teal-050 lg:mt-5">{entry.excerpt}</p>
            </div>
            {entry?.image && (
              <div class="w-full pt-5 md:w-1/2 md:pt-0">
                <div class="aspect-h-8 aspect-w-16">
                  <img class="object-contain w-auto h-full max-w-full mx-auto" src={entry.image} alt={entry.title} loading="eager" />
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    )}
  </header>

  <section>
    <div class="relative py-16 overflow-hidden bg-white">
      <div class="hidden lg:block lg:absolute lg:inset-y-0 lg:h-full lg:w-full">
        <div class="h-full mx-auto text-lg max-w-prose" aria-hidden="true">
          <svg class="absolute right-0 transform translate-x-64 top-12 xl:translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="74b3fd99-0a6f-4271-bef2-e80eeafdf357" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#74b3fd99-0a6f-4271-bef2-e80eeafdf357)" />
          </svg>
          <svg class="absolute left-0 transform -translate-x-64 -translate-y-1/2 top-1/2 xl:-translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="f210dbf6-a58d-4871-961e-36d5016a0f49" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#f210dbf6-a58d-4871-961e-36d5016a0f49)" />
          </svg>
          <svg class="absolute right-0 transform translate-x-64 bottom-12 xl:translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="d3eb07ae-5182-43e6-857d-35c643af9034" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#d3eb07ae-5182-43e6-857d-35c643af9034)" />
          </svg>
        </div>
      </div>
      <div class="relative px-4 sm:px-6 lg:px-8">
        <div class="mx-auto prose text-gray-500 prose-teal lg:prose-lg" set:html={entry?.html || ''} />
      </div>
    </div>
  </section>

  <section class="relative px-4 py-16 overflow-hidden sm:px-6 lg:px-8 lg:py-24" id="formular-danke">
    <div class="max-w-xl mx-auto" id="formular">
      <svg
        class="absolute bottom-0 left-0 transform -translate-x-64 xl:-translate-x-1/4"
        width="404"
        height="384"
        fill="none"
        viewBox="0 0 404 384"
      >
        <defs>
          <pattern id="operation-form-bg-pattern" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
            <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
          </pattern>
        </defs>
        <rect width="404" height="384" fill="url(#operation-form-bg-pattern)" />
      </svg>

      <div class="text-center">
        <h2
          id="operation-form-title"
          class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl"
          data-default-title={page?.form?.title || ''}
          data-success-title={page?.form?.successTitle || ''}
        >
          {page?.form?.title}
        </h2>
        <p
          id="operation-form-text"
          class="mt-4 text-lg leading-6 text-gray-500"
          data-default-text={page?.form?.text || ''}
          data-success-text={page?.form?.successText || ''}
        >
          {page?.form?.text}
        </p>
      </div>

      <div class="mt-12" id="operation-form-wrapper">
        <form
          action={`${Astro.url.pathname}#formular-danke`}
          method="POST"
          class="grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-8"
          data-netlify="true"
          name="operationsgespraech"
        >
          <input type="hidden" name="form-name" value="operationsgespraech" />
          <div>
            <label for="first_name" class="block text-sm font-medium text-gray-700">
              {page?.form?.name1}
              <div class="mt-1">
                <input
                  type="text"
                  required
                  name="first_name"
                  id="first_name"
                  autocomplete="given-name"
                  class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                />
              </div>
            </label>
          </div>
          <div>
            <label for="last_name" class="block text-sm font-medium text-gray-700">
              {page?.form?.name2}
              <div class="mt-1">
                <input
                  type="text"
                  required
                  name="last_name"
                  id="last_name"
                  autocomplete="family-name"
                  class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                />
              </div>
            </label>
          </div>
          <div class="sm:col-span-2">
            <label for="tel" class="block text-sm font-medium text-gray-700">
              {page?.form?.phone}
              <div class="mt-1">
                <input
                  type="tel"
                  name="tel"
                  required
                  id="tel"
                  autocomplete="tel"
                  class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                />
              </div>
            </label>
          </div>
          <div class="sm:col-span-2">
            <label for="email" class="block text-sm font-medium text-gray-700">
              {page?.form?.email}
              <div class="mt-1">
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                />
              </div>
            </label>
          </div>
          <div class="sm:col-span-2">
            <label for="operation" class="block text-sm font-medium text-gray-700">
              {page?.form?.operation}
              <div class="mt-1">
                <input
                  value={entry?.title || ''}
                  id="operation"
                  name="operation"
                  required
                  type="text"
                  class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                />
              </div>
            </label>
          </div>
          <div class="sm:col-span-2">
            <label for="message" class="block text-sm font-medium text-gray-700">
              {page?.form?.message}
              <div class="mt-1">
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                />
              </div>
            </label>
          </div>
          <div class="sm:col-span-2">
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <button
                  type="button"
                  id="data-protection-toggle"
                  class="relative inline-flex flex-shrink-0 h-6 transition-colors duration-200 ease-in-out bg-gray-200 border-2 border-transparent rounded-full cursor-pointer w-11 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500"
                  role="switch"
                  aria-checked="false"
                >
                  <input
                    id="data-protection-checkbox"
                    class="transform translate-x-3 translate-y-2 sr-only"
                    type="checkbox"
                    name="data_protection"
                    required
                  />
                  <span
                    id="data-protection-knob"
                    aria-hidden="true"
                    class="inline-block w-5 h-5 transition duration-200 ease-in-out transform translate-x-0 bg-white rounded-full shadow ring-0"
                  />
                </button>
              </div>
              <div class="ml-3">
                <p class="text-base text-gray-500">{page?.form?.dataProtection}</p>
              </div>
            </div>
          </div>
          <div class="sm:col-span-2">
            <button
              type="submit"
              class="inline-flex items-center justify-center w-full px-6 py-3 text-base font-medium text-white bg-teal-600 border border-transparent rounded-md shadow-sm hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500"
            >
              {page?.form?.button}
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script>
    const titleElement = document.getElementById('operation-form-title');
    const textElement = document.getElementById('operation-form-text');
    const formWrapper = document.getElementById('operation-form-wrapper');
    const isSuccess = window.location.hash === '#formular-danke';

    if (titleElement && textElement && isSuccess) {
      const successTitle = titleElement.getAttribute('data-success-title');
      const successText = textElement.getAttribute('data-success-text');
      if (successTitle) titleElement.textContent = successTitle;
      if (successText) textElement.textContent = successText;
    }

    if (formWrapper && isSuccess) {
      formWrapper.classList.add('hidden');
    }

    const toggle = document.getElementById('data-protection-toggle');
    const checkbox = document.getElementById('data-protection-checkbox');
    const knob = document.getElementById('data-protection-knob');
    if (toggle && checkbox && knob) {
      toggle.addEventListener('click', () => {
        checkbox.checked = !checkbox.checked;
        const enabled = checkbox.checked;
        toggle.classList.toggle('bg-teal-600', enabled);
        toggle.classList.toggle('bg-gray-200', !enabled);
        toggle.setAttribute('aria-checked', enabled ? 'true' : 'false');
        knob.classList.toggle('translate-x-5', enabled);
        knob.classList.toggle('translate-x-0', !enabled);
      });
    }
  </script>
</BaseLayout>
