---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageContentBySlug, getSettingContentBySlug } from '../lib/content';
import { getMemberEntries } from '../lib/collections';

const [page, members, indication] = await Promise.all([
  getPageContentBySlug('team'),
  getMemberEntries(),
  getSettingContentBySlug('indication'),
]);
---

<BaseLayout title={page?.meta?.title} description={page?.meta?.description}>
  <header class="bg-teal-800 shadow">
    <div class="relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-6">
        <div class="flex flex-col-reverse md:flex-row md:justify-between md:items-center">
          <div class="max-w-xl py-8 md:pt-8 md:pb-10">
            <h1 class="text-4xl font-medium text-teal-050 md:text-5xl sm:tracking-tight">{page?.header?.title}</h1>
            <p class="mt-2 text-xl text-teal-050 lg:mt-5">{page?.header?.text}</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section>
    <div class="bg-white" id="aerzte">
      <div class="mx-auto py-12 px-4 max-w-7xl sm:px-6 lg:px-8 lg:py-24">
        <ul class="space-y-12 max-w-4xl mx-auto sm:divide-y sm:divide-gray-200 sm:space-y-0 sm:-mt-8 lg:gap-x-8 lg:space-y-0">
          {members.map((member) => (
            <li class="sm:py-8" id={member.slug}>
              <div class="space-y-4 sm:grid sm:grid-cols-12 sm:items-start sm:gap-12 sm:space-y-0">
                <div class="sm:col-span-3 h-full">
                  <div class="sticky top-32">
                    <div class="aspect-w-3 aspect-h-2 sm:aspect-w-3 sm:aspect-h-4">
                      {member.image && <img class="object-cover shadow-lg rounded-lg" src={member.image} alt={member.title} />}
                    </div>
                  </div>
                </div>
                <div class="sm:col-span-9">
                  <div class="space-y-4">
                    <div class="text-lg leading-6 font-medium space-y-1">
                      <h2>{member.title}</h2>
                      <p class="text-teal-600">{member.subtitle}</p>
                    </div>
                    <div class="prose prose-lg" set:html={member.html} />
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <aside>
    <div class="fixed right-0 z-50 top-[25vh] lg:top-[15vh]">
      <button
        id="indication-toggle"
        type="button"
        class="bg-gray-900 text-gray-050 p-3 w-12 rounded-l-full cursor-pointer hover:bg-gray-800 focus:outline-none"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>
      <div id="indication-panel" class="absolute right-0 w-80 transform translate-x-full transition-transform duration-150">
        <div class="bg-gray-050 text-gray-900 rounded-l-lg shadow-lg">
          <div class="p-4">
            <h2 class="text-lg font-medium">{indication?.title}</h2>
            <p class="mt-2 whitespace-pre-line">{indication?.text}</p>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <script>
    const toggle = document.getElementById('indication-toggle');
    const panel = document.getElementById('indication-panel');
    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        panel.classList.toggle('translate-x-full');
      });
    }
  </script>
</BaseLayout>
