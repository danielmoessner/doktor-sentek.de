{
  "name": "website",
  "description": "A beautiful and sweet webseite.",
  "license": "UNLICENSED",
  "private": true,
  "version": "0.0.0",
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/aspect-ratio": "^0.2.0",
    "@tailwindcss/forms": "^0.3.2",
    "@tailwindcss/line-clamp": "^0.2.0",
    "@tailwindcss/typography": "^0.4.0",
    "autoprefixer": "^10.2.5",
    "astro": "^5.13.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^14.1.2",
    "netlify-cms-app": "^2.14.40",
    "netlify-cms-locales": "^1.29.2",
    "postcss": "^8.2.9",
    "postcss-loader": "^5.2.0",
    "postcss-preset-env": "^6.7.0",
    "sanitize-html": "^2.3.3",
    "tailwindcss": "^2.1.1"
  },
  "main": "npm run dev",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "dev": "npm-run-all --parallel astro:dev cms",
    "develop": "npm run astro:dev",
    "astro:dev": "astro dev --host localhost --port 4321",
    "dev:astro": "npm run astro:dev",
    "preview": "astro preview --host localhost --port 4321",
    "cms": "npx netlify-cms-proxy-server",
    "update": "npx npm-check-updates -u --timeout 60000 && npm install",
    "format": "prettier --trailing-comma es5 --no-semi --single-quote --write \"{src/**/*.{astro,js}}\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "eslint": "^7.23.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^8.1.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-prettier": "^3.3.1",
    "kill-port": "^1.6.1",
    "netlify-cms-proxy-server": "^1.3.24",
    "nodemon": "^2.0.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.2.1"
  },
  "browserslist": "defaults"
}
