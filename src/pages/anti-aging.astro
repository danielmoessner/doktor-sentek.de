---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageContentBySlug } from '../lib/content';

const page = await getPageContentBySlug('antiAging');
---

<BaseLayout title={page?.meta?.title} description={page?.meta?.description}>
  <section>
    <div class="relative py-16 bg-white overflow-hidden">
      <div class="hidden lg:block lg:absolute lg:inset-y-0 lg:h-full lg:w-full">
        <div class="h-full text-lg max-w-prose mx-auto" aria-hidden="true">
          <svg class="absolute top-12 right-0 transform translate-x-64 xl:translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="74b3fd99-0a6f-4271-bef2-e80eeafdf357" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#74b3fd99-0a6f-4271-bef2-e80eeafdf357)" />
          </svg>
          <svg class="absolute top-1/2 left-0 transform -translate-y-1/2 -translate-x-64 xl:-translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="f210dbf6-a58d-4871-961e-36d5016a0f49" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#f210dbf6-a58d-4871-961e-36d5016a0f49)" />
          </svg>
          <svg class="absolute bottom-12 right-0 transform translate-x-64 xl:translate-x-1/4" width="404" height="384" fill="none" viewBox="0 0 404 384">
            <defs>
              <pattern id="d3eb07ae-5182-43e6-857d-35c643af9034" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="404" height="384" fill="url(#d3eb07ae-5182-43e6-857d-35c643af9034)" />
          </svg>
        </div>
      </div>

      <div class="relative px-4 sm:px-6 lg:px-8">
        {page?.header && (
          <header class="mb-6 text-lg max-w-prose mx-auto">
            <h1>
              <span class="block text-base text-center text-teal-800 font-semibold tracking-wide uppercase">{page.header.pretitle}</span>
              <span class="mt-2 block text-3xl text-center leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">{page.header.title}</span>
            </h1>
            <p class="mt-8 text-xl text-gray-500 leading-8">{page.header.text}</p>
          </header>
        )}
        <div class="prose prose-teal lg:prose-lg text-gray-500 mx-auto" set:html={page?.bodyHtml || ''} />
      </div>
    </div>
  </section>

  <section class="relative py-16 px-4 overflow-hidden sm:px-6 lg:px-8 lg:py-24" id="formular-danke">
    <div class="max-w-xl mx-auto" id="formular">
      <svg
        class="absolute bottom-0 left-0 transform -translate-x-64 xl:-translate-x-1/4"
        width="404"
        height="384"
        fill="none"
        viewBox="0 0 404 384"
      >
        <defs>
          <pattern id="anti-aging-form-bg-pattern" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
            <rect x="0" y="0" width="4" height="4" class="text-gray-200" fill="currentColor" />
          </pattern>
        </defs>
        <rect width="404" height="384" fill="url(#anti-aging-form-bg-pattern)" />
      </svg>

      <div class="mt-12">
        <h2
          id="anti-aging-form-title"
          class="text-3xl text-center font-extrabold tracking-tight text-gray-900 sm:text-4xl"
          data-default-title={page?.form?.title || ''}
          data-success-title={page?.form?.successTitle || ''}
        >
          {page?.form?.title}
        </h2>

        <p
          id="anti-aging-form-text"
          class="mt-4 text-lg leading-6 text-gray-500 text-center"
          data-success-text={page?.form?.successText || ''}
        />

        <div class="mt-8" id="anti-aging-form-wrapper">
          <form
            action={`${Astro.url.pathname}#formular-danke`}
            method="POST"
            class="grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-8"
            data-netlify="true"
            name="antiagingformular"
          >
            <input type="hidden" name="form-name" value="antiagingformular" />
            <input type="hidden" name="category" value="Anti Aging" />

            <div>
              <label for="vorname" class="block text-sm font-medium text-gray-700">
                {page?.form?.name1}
                <div class="mt-1">
                  <input
                    type="text"
                    required
                    name="vorname"
                    id="vorname"
                    autocomplete="given-name"
                    class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                  />
                </div>
              </label>
            </div>

            <div>
              <label for="nachname" class="block text-sm font-medium text-gray-700">
                {page?.form?.name2}
                <div class="mt-1">
                  <input
                    type="text"
                    required
                    name="nachname"
                    id="nachname"
                    autocomplete="family-name"
                    class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                  />
                </div>
              </label>
            </div>

            <div class="sm:col-span-2">
              <label for="phone" class="block text-sm font-medium text-gray-700">
                {page?.form?.phone}
                <div class="mt-1">
                  <input
                    type="tel"
                    required
                    name="phone"
                    id="phone"
                    autocomplete="tel"
                    class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                  />
                </div>
              </label>
            </div>

            <div class="sm:col-span-2">
              <label for="email" class="block text-sm font-medium text-gray-700">
                {page?.form?.email}
                <div class="mt-1">
                  <input
                    type="email"
                    required
                    name="email"
                    id="email"
                    autocomplete="email"
                    class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                  />
                </div>
              </label>
            </div>

            <div class="sm:col-span-2">
              <label for="nachricht" class="block text-sm font-medium text-gray-700">
                {page?.form?.message}
                <div class="mt-1">
                  <textarea
                    id="nachricht"
                    name="nachricht"
                    rows="3"
                    class="block w-full px-4 py-3 border-gray-300 rounded-md shadow-sm focus:ring-teal-500 focus:border-teal-500"
                  />
                </div>
              </label>
            </div>

            <div class="sm:col-span-2">
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <button
                    type="button"
                    id="anti-aging-data-protection-toggle"
                    class="bg-gray-200 relative inline-flex flex-shrink-0 h-6 w-11 border-2 border-transparent rounded-full cursor-pointer transition-colors ease-in-out duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500"
                    role="switch"
                    aria-checked="false"
                  >
                    <input
                      id="anti-aging-data-protection-checkbox"
                      class="transform translate-x-3 translate-y-2 sr-only"
                      type="checkbox"
                      name="datenschutz"
                      required
                    />
                    <span
                      id="anti-aging-data-protection-knob"
                      aria-hidden="true"
                      class="translate-x-0 inline-block h-5 w-5 rounded-full bg-white shadow transform ring-0 transition ease-in-out duration-200"
                    />
                  </button>
                </div>
                <div class="ml-3">
                  <p class="text-base text-gray-500">{page?.form?.dataProtection}</p>
                </div>
              </div>
            </div>

            <div class="sm:col-span-2">
              <button
                type="submit"
                class="inline-flex items-center justify-center w-full px-6 py-3 text-base font-medium text-white bg-teal-600 border border-transparent rounded-md shadow-sm hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500"
              >
                {page?.form?.button}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    const titleElement = document.getElementById('anti-aging-form-title');
    const textElement = document.getElementById('anti-aging-form-text');
    const formWrapper = document.getElementById('anti-aging-form-wrapper');
    const isSuccess = window.location.hash === '#formular-danke';

    if (titleElement && textElement && isSuccess) {
      const successTitle = titleElement.getAttribute('data-success-title');
      const successText = textElement.getAttribute('data-success-text');
      if (successTitle) titleElement.textContent = successTitle;
      if (successText) textElement.textContent = successText;
    }

    if (formWrapper && isSuccess) {
      formWrapper.classList.add('hidden');
    }

    const toggle = document.getElementById('anti-aging-data-protection-toggle');
    const checkbox = document.getElementById('anti-aging-data-protection-checkbox');
    const knob = document.getElementById('anti-aging-data-protection-knob');
    if (toggle && checkbox && knob) {
      toggle.addEventListener('click', () => {
        checkbox.checked = !checkbox.checked;
        const enabled = checkbox.checked;
        toggle.classList.toggle('bg-teal-600', enabled);
        toggle.classList.toggle('bg-gray-200', !enabled);
        toggle.setAttribute('aria-checked', enabled ? 'true' : 'false');
        knob.classList.toggle('translate-x-5', enabled);
        knob.classList.toggle('translate-x-0', !enabled);
      });
    }
  </script>
</BaseLayout>
