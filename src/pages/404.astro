---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite existiert nicht.">
  <section class="bg-white rounded-lg border border-gray-100 p-8">
    <h1 class="text-3xl font-bold text-gray-900">Seite nicht gefunden</h1>
    <p class="mt-3 text-gray-600">Die angeforderte Seite konnte nicht gefunden werden.</p>
    <a href="/" class="mt-5 inline-flex text-teal-700 font-semibold hover:text-teal-800">Zur Startseite</a>
  </section>
</BaseLayout>
