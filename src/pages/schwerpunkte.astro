---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageContentBySlug } from '../lib/content';
import { cmsAssetToPublicUrl } from '../lib/cms-paths';
import { getOperationEntries, getTherapyEntries } from '../lib/collections';
import { getSettingContentBySlug } from '../lib/content';

const [
  page,
  operations,
  therapies,
  outpatientSurgery,
  inpatientSurgery,
  antiAging,
  indication,
] = await Promise.all([
  getPageContentBySlug('focus'),
  getOperationEntries(),
  getTherapyEntries(),
  getPageContentBySlug('outpatientSurgery'),
  getPageContentBySlug('inpatientSurgery'),
  getPageContentBySlug('antiAging'),
  getSettingContentBySlug('indication'),
]);
const image = cmsAssetToPublicUrl(page?.header?.image);
---

<BaseLayout title={page?.meta?.title} description={page?.meta?.description}>
  <header class="bg-teal-800 shadow">
    {page?.header?.title && page?.header?.text && (
      <div class="relative overflow-hidden">
        <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-6">
          <div class="flex flex-col-reverse md:flex-row md:justify-between md:items-center">
            <div class="max-w-xl py-8 md:pt-8 md:pb-10">
              <h1 class="text-4xl font-medium text-teal-050 md:text-5xl sm:tracking-tight">{page.header.title}</h1>
              <p class="mt-2 text-xl text-teal-050 lg:mt-5">{page.header.text}</p>
            </div>
            {image && (
              <div class="w-full pt-5 md:w-1/2 md:pt-0">
                <div class="aspect-h-8 aspect-w-16">
                  <img class="object-contain w-auto h-full max-w-full mx-auto" src={image} alt={page.header.title} loading="eager" />
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    )}
  </header>

  <section class="bg-white">
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="pt-4 pb-32">
        <div class="relative divide-y-2 divide-gray-100 lg:px-4">
          <div class="grid gap-16 pt-10 mt-6 lg:grid-cols-3 lg:gap-x-5 lg:gap-y-12">
            <div>
              <a href="/stationaeres-operieren/" class="block mt-2">
                <p class="text-xl font-semibold text-gray-900">{inpatientSurgery?.header?.title}</p>
                <p class="mt-3 text-base text-gray-500 line-clamp-3">{inpatientSurgery?.header?.text}</p>
              </a>
              <div class="mt-3">
                <a href="/stationaeres-operieren/" class="text-base font-semibold text-teal-600 hover:text-teal-500">{page?.content?.button}</a>
              </div>
            </div>
            <div>
              <a href="/ambulantes-operieren/" class="block mt-2">
                <p class="text-xl font-semibold text-gray-900">{outpatientSurgery?.header?.title}</p>
                <p class="mt-3 text-base text-gray-500 line-clamp-3">{outpatientSurgery?.header?.text}</p>
              </a>
              <div class="mt-3">
                <a href="/ambulantes-operieren/" class="text-base font-semibold text-teal-600 hover:text-teal-500">{page?.content?.button}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="pt-4 pb-32 lg:px-4">
        <div class="relative divide-y-2 divide-gray-100">
          <div>
            <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">{page?.content?.operationsHeading}</h2>
          </div>
          <div class="grid gap-16 pt-10 mt-6 lg:grid-cols-3 lg:gap-x-5 lg:gap-y-12">
            {operations.map((post) => (
              <div>
                <a href={`/operationen/${post.routeSlug}/`} class="block mt-2">
                  <p class="text-xl font-semibold text-gray-900">{post.title}</p>
                  <p class="mt-3 text-base text-gray-500 line-clamp-3">{post.excerpt}</p>
                </a>
                <div class="mt-3">
                  <a href={`/operationen/${post.routeSlug}/`} class="text-base font-semibold text-teal-600 hover:text-teal-500">{page?.content?.button}</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="pt-4 pb-32 lg:px-4">
        <div class="relative divide-y-2 divide-gray-100">
          <div>
            <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">{page?.content?.therapiesHeading}</h2>
          </div>
          <div class="grid gap-16 pt-10 mt-6 lg:grid-cols-3 lg:gap-x-5 lg:gap-y-12">
            {therapies.map((post) => (
              <div>
                <a href={`/konservative-therapien/${post.routeSlug}/`} class="block mt-2">
                  <p class="text-xl font-semibold text-gray-900">{post.title}</p>
                  <p class="mt-3 text-base text-gray-500 line-clamp-3">{post.excerpt}</p>
                </a>
                <div class="mt-3">
                  <a href={`/konservative-therapien/${post.routeSlug}/`} class="text-base font-semibold text-teal-600 hover:text-teal-500">{page?.content?.button}</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="pt-4 pb-32 lg:px-4">
        <div class="relative divide-y-2 divide-gray-100">
          <div>
            <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">{page?.content?.moreHeading}</h2>
          </div>
          <div class="grid gap-16 pt-10 mt-6 lg:grid-cols-3 lg:gap-x-5 lg:gap-y-12">
            <div>
              <a href="/anti-aging/" class="block mt-2">
                <p class="text-xl font-semibold text-gray-900">{antiAging?.header?.title}</p>
                <p class="mt-3 text-base text-gray-500 line-clamp-3">{antiAging?.header?.text}</p>
              </a>
              <div class="mt-3">
                <a href="/anti-aging/" class="text-base font-semibold text-teal-600 hover:text-teal-500">{page?.content?.button}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <aside>
    <div class="fixed right-0 z-50 top-[25vh] lg:top-[15vh]">
      <button id="indication-toggle" type="button" class="w-12 p-3 bg-gray-900 rounded-l-full cursor-pointer text-gray-050 hover:bg-gray-800 focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>
      <div id="indication-panel" class="absolute right-0 transition-transform duration-150 transform translate-x-full w-80">
        <div class="text-gray-900 rounded-l-lg shadow-lg bg-gray-050">
          <div class="p-4">
            <h2 class="text-lg font-medium">{indication?.title}</h2>
            <p class="mt-2 whitespace-pre-line">{indication?.text}</p>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <script>
    const toggle = document.getElementById('indication-toggle');
    const panel = document.getElementById('indication-panel');
    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        panel.classList.toggle('translate-x-full');
      });
    }
  </script>
</BaseLayout>
